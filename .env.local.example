# ============================================================
#  STACKWORK CLIENT PORTAL — ENVIRONMENT VARIABLES
#  Copy to .env.local (gitignored) and fill in real values from
#  your Supabase project: Dashboard → Project Settings → API.
#  Set the SAME three vars in Vercel → Project → Settings →
#  Environment Variables for production.
# ============================================================

# Public (safe to expose in the browser bundle).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Bypasses Row-Level Security. NEVER prefix with
# NEXT_PUBLIC_, never import into a "use client" file, never commit.
# Used only by src/lib/supabase/admin.ts (guarded by `server-only`).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
